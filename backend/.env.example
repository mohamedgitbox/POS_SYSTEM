# Server
PORT=4000
# "development" enables verbose auth debug logs in the middleware;
# any other value (e.g. "production") silences them.
NODE_ENV=development

# MongoDB connection string (replace with your own credentials)
MONGO_URI=mongodb://localhost:27017/pos_system

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
